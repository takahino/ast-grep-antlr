    </Antlr4>
    <Compile Include="..\..\grammars\postgresql\CSharp\*.cs" LinkBase="PostgreSql" />
    <Antlr4 Include="..\..\grammars\mysql\MySqlLexer.g4">
      <Generator>MSBuild:Compile</Generator>
