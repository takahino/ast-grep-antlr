<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AstGrepAntlr.Languages</RootNamespace>
    <Description>Built-in language front-ends for AstGrepAntlr (tree-sitter / ANTLR / Roslyn).</Description>
    <PackageId>AstGrepAntlr.Languages</PackageId>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS0108: generated T-SQL / MySQL parsers have an EMPTY token accessor that hides ParserRuleContext.EMPTY. -->
    <NoWarn>$(NoWarn);CS1591;CS3021;CS0108</NoWarn>
    <Antlr4UseCSharpGenerator>true</Antlr4UseCSharpGenerator>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Antlr4.Runtime.Standard" />
    <PackageReference Include="Antlr4BuildTasks" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <!-- Managed TreeSitter.dll unused (own LibraryImport); keep native RID assets and flow them to consumers. -->
    <PackageReference
      Include="TreeSitter.DotNet"
      ExcludeAssets="compile"
      GeneratePathProperty="true"
      PrivateAssets="compile"
    />
    <ProjectReference Include="..\AstGrepAntlr.Core\AstGrepAntlr.Core.csproj" />
  </ItemGroup>
  <!-- Drop unused grammar natives from output/publish; keep core + the built-in tree-sitter languages. -->
  <Target Name="FilterTreeSitterNatives" AfterTargets="ResolvePackageAssets">
    <PropertyGroup>
      <_TsKeep>;tree-sitter;libtree-sitter;tree-sitter-java;libtree-sitter-java;tree-sitter-cpp;libtree-sitter-cpp;tree-sitter-python;libtree-sitter-python;tree-sitter-c-sharp;libtree-sitter-c-sharp;tree-sitter-javascript;libtree-sitter-javascript;tree-sitter-typescript;libtree-sitter-typescript;tree-sitter-tsx;libtree-sitter-tsx;tree-sitter-go;libtree-sitter-go;tree-sitter-rust;libtree-sitter-rust;tree-sitter-c;libtree-sitter-c;tree-sitter-ruby;libtree-sitter-ruby;tree-sitter-php;libtree-sitter-php;tree-sitter-bash;libtree-sitter-bash;tree-sitter-html;libtree-sitter-html;tree-sitter-css;libtree-sitter-css;tree-sitter-json;libtree-sitter-json;tree-sitter-scala;libtree-sitter-scala;tree-sitter-haskell;libtree-sitter-haskell;tree-sitter-julia;libtree-sitter-julia;tree-sitter-ocaml;libtree-sitter-ocaml;tree-sitter-toml;libtree-sitter-toml;tree-sitter-verilog;libtree-sitter-verilog;</_TsKeep>
    </PropertyGroup>
    <ItemGroup>
      <_TsDrop
        Include="@(NativeCopyLocalItems)"
        Condition="$([System.String]::Copy('%(Filename)').Contains('tree-sitter')) and !$(_TsKeep.Contains(';%(Filename);'))"
      />
      <NativeCopyLocalItems Remove="@(_TsDrop)" />
      <_TsDropPublish
        Include="@(ResolvedFileToPublish)"
        Condition="$([System.String]::Copy('%(Filename)').Contains('tree-sitter')) and !$(_TsKeep.Contains(';%(Filename);'))"
      />
      <ResolvedFileToPublish Remove="@(_TsDropPublish)" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <Antlr4 Include="..\..\grammars\java\JavaLexer.g4">
      <Generator>MSBuild:Compile</Generator>
      <Listener>false</Listener>
      <Visitor>false</Visitor>
      <Package>AstGrepAntlr.Languages.Java</Package>
    </Antlr4>
    <Antlr4 Include="..\..\grammars\java\JavaParser.g4">
      <Generator>MSBuild:Compile</Generator>
      <Listener>false</Listener>
      <Visitor>false</Visitor>
      <Package>AstGrepAntlr.Languages.Java</Package>
    </Antlr4>
    <Compile Include="..\..\grammars\java\JavaParserBase.cs" Link="Java\JavaParserBase.cs" />
    <Antlr4 Include="..\..\grammars\sqlite\SQLiteLexer.g4">
      <Generator>MSBuild:Compile</Generator>
      <Listener>false</Listener>
