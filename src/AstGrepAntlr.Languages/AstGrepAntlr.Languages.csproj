    <Antlr4 Include="..\..\grammars\mysql\MySqlParser.g4">
      <Generator>MSBuild:Compile</Generator>
      <Listener>false</Listener>
      <Visitor>false</Visitor>
      <Package>AstGrepAntlr.Languages.MySql</Package>
    </Antlr4>
  </ItemGroup>
</Project>
