<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AstGrepAntlr.Languages</RootNamespace>
    <Description>Built-in language front-ends for AstGrepAntlr (tree-sitter / ANTLR / Roslyn).</Description>
    <PackageId>AstGrepAntlr.Languages</PackageId>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS3021</NoWarn>
    <Antlr4UseCSharpGenerator>true</Antlr4UseCSharpGenerator>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Antlr4.Runtime.Standard" />
    <PackageReference Include="Antlr4BuildTasks" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <!-- Managed TreeSitter.dll unused (own LibraryImport); keep native RID assets and flow them to consumers. -->
    <PackageReference
      Include="TreeSitter.DotNet"
      ExcludeAssets="compile"
      GeneratePathProperty="true"
      PrivateAssets="compile"
    />
    <ProjectReference Include="..\AstGrepAntlr.Core\AstGrepAntlr.Core.csproj" />
  </ItemGroup>
  <!-- Drop unused grammar natives from output/publish; keep core + java/cpp/python. -->
  <Target Name="FilterTreeSitterNatives" AfterTargets="ResolvePackageAssets">
    <PropertyGroup>
      <_TsKeep>;tree-sitter;libtree-sitter;tree-sitter-java;libtree-sitter-java;tree-sitter-cpp;libtree-sitter-cpp;tree-sitter-python;libtree-sitter-python;</_TsKeep>
    </PropertyGroup>
    <ItemGroup>
      <_TsDrop
        Include="@(NativeCopyLocalItems)"
        Condition="$([System.String]::Copy('%(Filename)').Contains('tree-sitter')) and !$(_TsKeep.Contains(';%(Filename);'))"
      />
      <NativeCopyLocalItems Remove="@(_TsDrop)" />
      <_TsDropPublish
        Include="@(ResolvedFileToPublish)"
        Condition="$([System.String]::Copy('%(Filename)').Contains('tree-sitter')) and !$(_TsKeep.Contains(';%(Filename);'))"
      />
      <ResolvedFileToPublish Remove="@(_TsDropPublish)" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <Antlr4 Include="..\..\grammars\java\JavaLexer.g4">
      <Generator>MSBuild:Compile</Generator>
      <Listener>false</Listener>
      <Visitor>false</Visitor>
      <Package>AstGrepAntlr.Languages.Java</Package>
    </Antlr4>
    <Antlr4 Include="..\..\grammars\java\JavaParser.g4">
      <Generator>MSBuild:Compile</Generator>
      <Listener>false</Listener>
      <Visitor>false</Visitor>
      <Package>AstGrepAntlr.Languages.Java</Package>
    </Antlr4>
    <Compile Include="..\..\grammars\java\JavaParserBase.cs" Link="Java\JavaParserBase.cs" />
    <Antlr4 Include="..\..\grammars\sqlite\SQLiteLexer.g4">
      <Generator>MSBuild:Compile</Generator>
      <Listener>false</Listener>
      <Visitor>false</Visitor>
      <Package>AstGrepAntlr.Languages.Sqlite</Package>
    </Antlr4>
    <Antlr4 Include="..\..\grammars\sqlite\SQLiteParser.g4">
      <Generator>MSBuild:Compile</Generator>
      <Listener>false</Listener>
      <Visitor>false</Visitor>
      <Package>AstGrepAntlr.Languages.Sqlite</Package>
    </Antlr4>
    <Antlr4 Include="..\..\grammars\cpp\CPP14Lexer.g4">
      <Generator>MSBuild:Compile</Generator>
      <Listener>false</Listener>
      <Visitor>false</Visitor>
      <Package>AstGrepAntlr.Languages.Cpp</Package>
    </Antlr4>
    <Antlr4 Include="..\..\grammars\cpp\CPP14Parser.g4">
      <Generator>MSBuild:Compile</Generator>
      <Listener>false</Listener>
      <Visitor>false</Visitor>
      <Package>AstGrepAntlr.Languages.Cpp</Package>
    </Antlr4>
    <Compile Include="..\..\grammars\cpp\CSharp\CPP14ParserBase.cs" Link="Cpp\CPP14ParserBase.cs" />
    <Antlr4 Include="..\..\grammars\python\Python3Lexer.g4">
      <Generator>MSBuild:Compile</Generator>
      <Listener>false</Listener>
      <Visitor>false</Visitor>
      <Package>AstGrepAntlr.Languages.Python</Package>
    </Antlr4>
    <Antlr4 Include="..\..\grammars\python\Python3Parser.g4">
      <Generator>MSBuild:Compile</Generator>
      <Listener>false</Listener>
      <Visitor>false</Visitor>
      <Package>AstGrepAntlr.Languages.Python</Package>
    </Antlr4>
    <Compile Include="..\..\grammars\python\CSharp\Python3LexerBase.cs" Link="Python\Python3LexerBase.cs" />
    <Compile Include="..\..\grammars\python\CSharp\Python3ParserBase.cs" Link="Python\Python3ParserBase.cs" />
    <Antlr4 Include="..\..\grammars\plsql\PlSqlLexer.g4">
      <Generator>MSBuild:Compile</Generator>
      <Listener>false</Listener>
      <Visitor>false</Visitor>
      <Package>AstGrepAntlr.Languages.PlSql</Package>
    </Antlr4>
    <Antlr4 Include="..\..\grammars\plsql\PlSqlParser.g4">
      <Generator>MSBuild:Compile</Generator>
      <Listener>false</Listener>
      <Visitor>false</Visitor>
      <Package>AstGrepAntlr.Languages.PlSql</Package>
    </Antlr4>
    <Compile Include="..\..\grammars\plsql\CSharp\PlSqlLexerBase.cs" Link="PlSql\PlSqlLexerBase.cs" />
    <Compile Include="..\..\grammars\plsql\CSharp\PlSqlParserBase.cs" Link="PlSql\PlSqlParserBase.cs" />
  </ItemGroup>
</Project>
