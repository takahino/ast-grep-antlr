<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AstGrepAntlr.Native</RootNamespace>
    <AssemblyName>ag4_native</AssemblyName>
    <Description>NativeAOT shared library (C ABI) for embedding ag4 search.</Description>
    <PackageId>AstGrepAntlr.Native</PackageId>
    <IsPackable>false</IsPackable>
    <NativeLib>Shared</NativeLib>
    <PublishAot>true</PublishAot>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-arm64</RuntimeIdentifiers>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS1591;CA1852</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <TrimmerRootAssembly Include="AstGrepAntlr.Core" />
    <TrimmerRootAssembly Include="AstGrepAntlr.Languages" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AstGrepAntlr.Core\AstGrepAntlr.Core.csproj" />
    <ProjectReference Include="..\AstGrepAntlr.Languages\AstGrepAntlr.Languages.csproj" />
  </ItemGroup>
</Project>
